PORT=4000

# Option A (recommended): full Mongo URI
MONGODB_URI=mongodb://127.0.0.1:27017/baskaro

# Option B: build from individual env vars (use if you don't want to store full URI)
# MONGO_HOST=127.0.0.1
# MONGO_PORT=27017
# MONGO_DB=baskaro
# MONGO_USER=
# MONGO_PASS=
# MONGO_AUTH_SOURCE=admin
# MONGO_TLS=false

JWT_SECRET=dev-secret

# Cloudinary — store images for services, brands, offers, banners, inventory, etc.
# Dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: public base URL for legacy /hero/* paths in API responses
# PUBLIC_API_URL=https://api.baskaro.com

# Frontend dev origin examples:
# Comma-separated frontend origins (production + local dev)
CORS_ORIGIN=https://baskaro.com,https://www.baskaro.com,http://localhost:5173,http://localhost:3000,http://localhost:3002
# CORS_ALLOW_ALL=true

# Razorpay — buy-side checkout (pre-owned). Leave empty for local mock payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Order confirmations (optional). If omitted, app logs confirmation payload only.
# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Baskaro <orders@baskaro.com>"
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Expired cart-hold cleanup scheduler (ms). Minimum enforced: 30000.
# Set RESERVATION_CLEANUP_DISABLED=true to turn it off.
RESERVATION_CLEANUP_INTERVAL_MS=600000

